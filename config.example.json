{
  "repo": "/path/to/your/repo",
  "domain": "my-project",
  "test_cmd": "python3 -m pytest -q",
  "steps": {
    "plan": {
      "cli": "claude",
      "model": "sonnet",
      "permission": "acceptEdits"
    },
    "write-test": {
      "cli": "grok"
    },
    "execute": {
      "cli": "dsh"
    },
    "review": {
      "cli": "claude",
      "model": "opus",
      "permission": "acceptEdits"
    },
    "verify": {
      "cli": "grok"
    },
    "remember": {
      "cli": "none"
    },
    "improve": {
      "cli": "claude",
      "model": "sonnet",
      "permission": "acceptEdits"
    }
  },
  "gates": ["execute"],
  "timeout_s": 900,
  "harness_dir": ".sag/harness",
  "runs_dir": ".sag/runs",
  "memory_dir": ".sag/memory",
  "library_dir": ".sag/library"
}
